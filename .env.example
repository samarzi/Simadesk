# ─────────────────────────────────────────────────────────────────────────────
# STOCKBASE — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (found in: Project Settings → API → Project URL)
VITE_SUPA_URL=https://your-project-id.supabase.co

# Supabase anon/public key (found in: Project Settings → API → anon public)
# This key is safe to use on the frontend — it respects Row Level Security (RLS).
# IMPORTANT: Enable RLS on all tables before deploying to production.
VITE_SUPA_KEY=your-anon-key-here
