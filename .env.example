# ─────────────────────────────────────────────────────────────────────────────
#  SimaDesk VPS — Environment Variables
#  Скопируй в .env и заполни значениями
#  НЕ КОММИТЬ .env в git!
# ─────────────────────────────────────────────────────────────────────────────

# ── Домен ─────────────────────────────────────────────────────────────────────
SITE_URL=https://simadesk.ru
API_EXTERNAL_URL=https://simadesk.ru
ADDITIONAL_REDIRECT_URLS=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Сгенерируй: openssl rand -base64 32
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ

# ── JWT секреты ───────────────────────────────────────────────────────────────
# Сгенерируй: openssl rand -base64 64
JWT_SECRET=ЗАМЕНИ_НА_64_БАЙТА

# Anon key и Service Role key — JWT-токены, подписанные JWT_SECRET.
# Сгенерируй через: bash scripts/gen-keys.sh
ANON_KEY=СГЕНЕРИРУЙ_СМОТРИ_scripts/gen-keys.sh
SERVICE_ROLE_KEY=СГЕНЕРИРУЙ_СМОТРИ_scripts/gen-keys.sh

# ── Шифрование ключей маркетплейсов ──────────────────────────────────────────
# AES-256-GCM ключ для api_key Ozon/WB/Яндекс. Живёт ТОЛЬКО здесь (edge runtime),
# в БД и браузер не попадает. Сгенерируй: openssl rand -base64 32
MP_ENC_KEY=СГЕНЕРИРУЙ_openssl_rand_base64_32

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=ТОКЕН_БОТА_ОТ_BOTFATHER
TELEGRAM_BOT_USERNAME=simadesk_bot

# ── Realtime (случайные строки) ───────────────────────────────────────────────
# Сгенерируй: openssl rand -base64 32
REALTIME_ENC_KEY=СЛУЧАЙНАЯ_СТРОКА_32_БАЙТА
# Сгенерируй: openssl rand -base64 64
REALTIME_SECRET_KEY_BASE=СЛУЧАЙНАЯ_СТРОКА_64_БАЙТА

# ── SMTP (опционально, для email-уведомлений) ─────────────────────────────────
SMTP_ADMIN_EMAIL=admin@samarzi.online
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=SimaDesk
