{
  "manifest_version": 3,
  "name": "SimaDesk Automation",
  "version": "1.1.5",
  "description": "Автоматизация настройки складов и тарифов для Яндекс Маркета и Ozon",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "windows",
    "scripting",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "https://partner.market.yandex.ru/*",
    "https://seller.ozon.ru/*",
    "https://market.yandex.ru/*",
    "https://rdqwzojrsmbdxiczqjci.supabase.co/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },

  "externally_connectable": {
    "matches": [
      "https://sabatov.netlify.app/*",
      "http://localhost:*/*"
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["lib/karta.json"],
      "matches": ["https://partner.market.yandex.ru/*"]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "https://sabatov.netlify.app/*",
        "http://localhost:*/*"
      ],
      "js": ["content/simadesk-bridge-isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://sabatov.netlify.app/*",
        "http://localhost:*/*"
      ],
      "js": ["content/simadesk-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://partner.market.yandex.ru/*"],
      "js": ["lib/utils.js", "content/yandex-common.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seller.ozon.ru/*"],
      "js": ["lib/utils.js", "content/ozon-common.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://market.yandex.ru/product/*", "https://market.yandex.ru/card/*"],
      "js": ["content/yandex-price-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://market.yandex.ru/product/*", "https://market.yandex.ru/card/*"],
      "js": ["content/yandex-price-isolated.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
